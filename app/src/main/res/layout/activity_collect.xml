<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 手机版：长按海报后弹出的顶部操作条（全选 / 删除） -->
    <LinearLayout
        android:id="@+id/selectBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_45"
        android:layout_marginLeft="@dimen/vs_12"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginRight="@dimen/vs_12"
        android:background="@drawable/shape_history_action_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:maxLines="1"
            android:text="已选 0 项"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_18" />

        <Space
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_1"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:text="全选"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:text="删除"
            android:textColor="@color/color_FF0057"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_0"
        android:layout_weight="1"
        android:paddingLeft="@dimen/vs_10"
        android:paddingTop="@dimen/vs_10"
        android:paddingRight="@dimen/vs_10"
        android:paddingBottom="@dimen/vs_10"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
        app:tv_selectedItemIsCentered="false"
        app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
</LinearLayout>
