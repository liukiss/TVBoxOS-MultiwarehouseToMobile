<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 手机版：表单竖排，底部统一为四个等宽按钮（历史直播 / 存储权限 / 返回 / 确定） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/vs_12"
        android:layout_marginRight="@dimen/vs_12"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_16">

        <!-- 点播输入区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/vs_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="true"
                android:gravity="center"
                android:paddingRight="@dimen/vs_5"
                android:text="点播"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14"
                android:paddingEnd="@dimen/vs_5"
                android:cursorVisible="false"
                tools:ignore="RtlSymmetry,TextViewEdits" />

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_dialog_api_input"
                android:hint="请输入配置地址"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="text"
                android:minHeight="@dimen/vs_30"
                android:nextFocusDown="@id/inputLive"
                android:nextFocusForward="@id/inputLive"
                android:singleLine="true"
                android:maxLines="1"
                android:paddingLeft="@dimen/vs_2"
                android:paddingTop="@dimen/vs_6"
                android:paddingRight="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_6"
                android:textColor="@color/dialog_text_primary"
                android:textColorHint="@color/dialog_text_hint"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/inputSubmit"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_30"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/vs_5"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_10"
                android:paddingRight="@dimen/vs_10"
                android:text="选择"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14"
                android:layout_marginLeft="@dimen/vs_5" />
        </LinearLayout>

        <!-- 直播输入区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_8"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="true"
                android:gravity="center"
                android:paddingRight="@dimen/vs_5"
                android:text="直播"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14"
                android:paddingEnd="@dimen/vs_5"
                android:cursorVisible="false"
                tools:ignore="RtlSymmetry,TextViewEdits" />

            <EditText
                android:id="@+id/inputLive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_dialog_api_input"
                android:hint="请输入直播地址"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="text"
                android:minHeight="@dimen/vs_30"
                android:nextFocusDown="@id/inputConfirm"
                android:nextFocusForward="@id/inputConfirm"
                android:singleLine="true"
                android:maxLines="1"
                android:paddingLeft="@dimen/vs_2"
                android:paddingTop="@dimen/vs_6"
                android:paddingRight="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_6"
                android:textColor="@color/dialog_text_primary"
                android:textColorHint="@color/dialog_text_hint"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/inputSubmitLive"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_30"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/vs_5"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_10"
                android:paddingRight="@dimen/vs_10"
                android:text="选择"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14"
                android:layout_marginLeft="@dimen/vs_5" />
        </LinearLayout>

        <!-- 底部四按钮：历史直播 / 存储权限 / 返回 / 确定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/apiHistory"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_36"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="历史直播"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/storagePermission"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_36"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/vs_4"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="存储权限"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/apiBack"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_36"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/vs_4"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="返回"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/inputConfirm"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_36"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/vs_4"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="确定"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
