<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/userBottomBar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_50"
    android:background="#99000000"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_10"
    android:paddingRight="@dimen/vs_10">

    <LinearLayout
        android:id="@+id/tvHome"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_45"
        android:layout_marginLeft="@dimen/vs_4"
        android:layout_marginRight="@dimen/vs_4"
        android:layout_weight="1"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/vs_2">

        <ImageView
            android:id="@+id/ivHome"
            android:layout_width="@dimen/vs_22"
            android:layout_height="@dimen/vs_22"
            android:alpha="0.75"
            android:src="@drawable/icon_home" />

        <TextView
            android:id="@+id/tvHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_1"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:text="主页"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tvLive"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_45"
        android:layout_marginLeft="@dimen/vs_4"
        android:layout_marginRight="@dimen/vs_4"
        android:layout_weight="1"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/vs_2">

        <ImageView
            android:id="@+id/ivLive"
            android:layout_width="@dimen/vs_22"
            android:layout_height="@dimen/vs_22"
            android:alpha="0.75"
            android:src="@drawable/icon_live" />

        <TextView
            android:id="@+id/tvLiveLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_1"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:text="直播"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tvHistory"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_45"
        android:layout_marginLeft="@dimen/vs_4"
        android:layout_marginRight="@dimen/vs_4"
        android:layout_weight="1"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/vs_2">

        <ImageView
            android:id="@+id/ivHistory"
            android:layout_width="@dimen/vs_22"
            android:layout_height="@dimen/vs_22"
            android:alpha="0.75"
            android:src="@drawable/icon_history" />

        <TextView
            android:id="@+id/tvHistoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_1"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:text="历史"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tvSearch"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_45"
        android:layout_marginLeft="@dimen/vs_4"
        android:layout_marginRight="@dimen/vs_4"
        android:layout_weight="1"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/vs_2">

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="@dimen/vs_22"
            android:layout_height="@dimen/vs_22"
            android:alpha="0.75"
            android:src="@drawable/icon_search" />

        <TextView
            android:id="@+id/tvSearchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_1"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:text="搜索"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>
</LinearLayout>
