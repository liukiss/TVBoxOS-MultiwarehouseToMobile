<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_12">

    <!-- 标题行：拖动条可向下拖动关闭 -->
    <LinearLayout
        android:id="@+id/sheetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_2"
        android:paddingBottom="@dimen/vs_2">

        <View
            android:id="@+id/dragHandle"
            android:layout_width="@dimen/vs_36"
            android:layout_height="@dimen/vs_4"
            android:layout_gravity="center_horizontal"
            android:background="@color/dialog_text_hint" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:gravity="center"
            android:text="直播源管理"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_28" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_4"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <com.github.tvbox.osc.ui.tv.widget.LoadingRingView
            android:id="@+id/loading"
            android:layout_width="@dimen/vs_50"
            android:layout_height="@dimen/vs_50"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 输入行：直播源名字 + 直播源地址 + 添加 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_6"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_live_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/input_dialog_api_input"
            android:hint="直播源名"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_8"
            android:paddingTop="@dimen/vs_6"
            android:paddingRight="@dimen/vs_8"
            android:paddingBottom="@dimen/vs_6"
            android:singleLine="true"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/dialog_text_hint"
            android:textSize="@dimen/ts_20" />

        <EditText
            android:id="@+id/input_live_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_4"
            android:layout_weight="3"
            android:background="@drawable/input_dialog_api_input"
            android:hint="直播源地址"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_8"
            android:paddingTop="@dimen/vs_6"
            android:paddingRight="@dimen/vs_8"
            android:paddingBottom="@dimen/vs_6"
            android:singleLine="true"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/dialog_text_hint"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/inputSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/vs_4"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_12"
            android:paddingTop="@dimen/vs_6"
            android:paddingRight="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_6"
            android:text="添加"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <!-- 底部操作：全部删除 / 存储权限 / 关闭，等分铺满 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_6"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/delAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingTop="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_6"
            android:text="全部删除"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/btnPerm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_4"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingTop="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_6"
            android:text="存储权限"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_4"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingTop="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_6"
            android:text="关闭"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>
</LinearLayout>
