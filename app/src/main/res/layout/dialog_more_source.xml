<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_14">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/vs_36"
        android:layout_height="@dimen/vs_4"
        android:layout_gravity="center_horizontal"
        android:background="@color/dialog_text_hint" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:gravity="center"
        android:text="多仓管理"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_30" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <ProgressBar
            android:id="@+id/play_loading"
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_40"
            android:layout_gravity="center"
            android:indeterminateBehavior="repeat"
            android:indeterminateOnly="true"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 输入行：仓库名 + 订阅链接 + 添加 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_sourceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/input_dialog_api_input"
            android:hint="仓库/线路名(可空)"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_2"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_2"
            android:paddingBottom="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/dialog_text_hint"
            android:textSize="@dimen/ts_24" />

        <EditText
            android:id="@+id/input_source_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_5"
            android:layout_weight="3"
            android:background="@drawable/input_dialog_api_input"
            android:hint="订阅链接"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_2"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_2"
            android:paddingBottom="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/dialog_text_hint"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/inputSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/vs_5"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:padding="@dimen/vs_10"
            android:text="添加"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>

    <!-- 底部操作：全部删除 / 存储权限 / 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:gravity="right"
        android:orientation="horizontal">

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/delAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_10"
            android:text="全部删除"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnPerm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_5"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_10"
            android:text="存储权限"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_5"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_10"
            android:text="关闭"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</LinearLayout>
