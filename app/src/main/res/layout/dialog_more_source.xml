<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="horizontal"
        android:padding="@dimen/vs_35">

        <ImageView
            android:id="@+id/qrCode"
            android:layout_width="@dimen/vs_280"
            android:layout_height="@dimen/vs_280"
            android:layout_gravity="center_vertical"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="@dimen/vs_610"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_20"
            android:layout_marginLeft="@dimen/vs_20"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_8"
                android:gravity="center"
                android:text="多仓管理"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/jump_web"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_8"
                android:focusable="false"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="扫码远程推送（多仓订阅链接）"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_300"
                android:layout_marginBottom="@dimen/vs_8">

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:tv_layoutManager="V7LinearLayoutManager"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_5" />

                <ProgressBar
                    android:id="@+id/play_loading"
                    android:layout_width="@dimen/vs_40"
                    android:layout_height="@dimen/vs_40"
                    android:layout_gravity="center"
                    android:indeterminateBehavior="repeat"
                    android:indeterminateOnly="true"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 输入行：仓库名 + 订阅链接 + 添加 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_8"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_sourceName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/input_dialog_api_input"
                    android:hint="仓库/线路名(可空)"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingLeft="@dimen/vs_2"
                    android:paddingTop="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_2"
                    android:paddingBottom="@dimen/vs_10"
                    android:singleLine="true"
                    android:textColor="@color/dialog_text_primary"
                    android:textColorHint="@color/dialog_text_hint"
                    android:textSize="@dimen/ts_24" />

                <EditText
                    android:id="@+id/input_source_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:layout_marginStart="@dimen/vs_5"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:background="@drawable/input_dialog_api_input"
                    android:hint="订阅链接"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingLeft="@dimen/vs_2"
                    android:paddingTop="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_2"
                    android:paddingBottom="@dimen/vs_10"
                    android:singleLine="true"
                    android:textColor="@color/dialog_text_primary"
                    android:textColorHint="@color/dialog_text_hint"
                    android:textSize="@dimen/ts_24" />

                <TextView
                    android:id="@+id/inputSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/vs_5"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:background="@drawable/button_danmu_setting"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/vs_10"
                    android:text="添加"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_22" />
            </LinearLayout>

            <!-- 底部操作 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/delAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_danmu_setting"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_30"
                    android:paddingTop="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_30"
                    android:paddingBottom="@dimen/vs_10"
                    android:text="全部删除"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:id="@+id/btnPerm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vs_5"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:background="@drawable/button_danmu_setting"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_30"
                    android:paddingTop="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_30"
                    android:paddingBottom="@dimen/vs_10"
                    android:text="存储权限"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:id="@+id/btnClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vs_5"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:background="@drawable/button_danmu_setting"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_30"
                    android:paddingTop="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_30"
                    android:paddingBottom="@dimen/vs_10"
                    android:text="关闭"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_22" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
