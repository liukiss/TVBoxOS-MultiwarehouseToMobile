<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/button_danmu_setting"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_32"
        android:layout_marginBottom="@dimen/vs_6"
        android:background="@drawable/shape_setting_sort_focus"
        android:focusable="true"
        android:singleLine="true"
        android:maxLines="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_12"
        android:visibility="visible">

        <TextView
            android:id="@+id/subtitleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:maxLines="1"
            android:text="字幕搜索结果"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_14" />
        <TextView
            android:id="@+id/subtitleNameInfo"
            android:layout_width="@dimen/vs_50"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_6"
            android:singleLine="true"
            android:maxLines="1"
            android:text="压缩包"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_10" />

    </LinearLayout>
</FrameLayout>
