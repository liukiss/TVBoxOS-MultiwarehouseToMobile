<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_control_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/live_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部直播播放器：16:9 原始比例 -->
        <FrameLayout
            android:id="@+id/playerLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_200"
            android:background="@android:color/black">

            <xyz.doikki.videoplayer.player.VideoView
                android:id="@+id/mVideoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.github.tvbox.osc.ui.tv.widget.LoadingRingView
                android:id="@+id/pbLiveLoading"
                android:layout_width="@dimen/vs_40"
                android:layout_height="@dimen/vs_40"
                android:layout_gravity="center" />

            <!-- 点击播放器区域进入全屏直播 -->
            <View
                android:id="@+id/playerClickArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="false" />
        </FrameLayout>

        <!-- 节目信息条：紧贴播放器下方，常显 -->
        <LinearLayout
            android:id="@+id/llProgramInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_control_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_6"
            android:paddingLeft="@dimen/vs_6"
            android:paddingTop="@dimen/vs_4"
            android:paddingEnd="@dimen/vs_6"
            android:paddingRight="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_4">

            <FrameLayout
                android:layout_width="@dimen/vs_45"
                android:layout_height="@dimen/vs_24">

                <ImageView
                    android:id="@+id/ivEpgChannelLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEpgChannelFallback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_14"
                    android:textStyle="bold"
                    tools:text="2" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_6"
                android:layout_marginLeft="@dimen/vs_6"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEpgChannelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_14"
                    android:textStyle="bold"
                    tools:text="CCTV-2 财经" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEpgCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:textColor="#CCFFFFFF"
                        android:textSize="@dimen/ts_9"
                        tools:text="12:36-13:13" />

                    <TextView
                        android:id="@+id/tvEpgCurrentName"
                        android:layout_width="@dimen/vs_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vs_4"
                        android:layout_marginLeft="@dimen/vs_4"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_9"
                        tools:text="防务新观察" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEpgNextTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:textColor="#99FFFFFF"
                        android:textSize="@dimen/ts_9"
                        tools:text="13:13-13:44" />

                    <TextView
                        android:id="@+id/tvEpgNextName"
                        android:layout_width="@dimen/vs_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vs_4"
                        android:layout_marginLeft="@dimen/vs_4"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#99FFFFFF"
                        android:textSize="@dimen/ts_9"
                        tools:text="军武零距离" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_4"
                android:layout_marginLeft="@dimen/vs_4"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEpgSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_live_resolution_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="@dimen/vs_4"
                    android:paddingTop="@dimen/vs_1"
                    android:paddingRight="@dimen/vs_4"
                    android:paddingBottom="@dimen/vs_1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/ts_9"
                    tools:text="线路1/2" />

                <TextView
                    android:id="@+id/tvEpgResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_2"
                    android:background="@drawable/shape_live_resolution_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="@dimen/vs_4"
                    android:paddingTop="@dimen/vs_1"
                    android:paddingRight="@dimen/vs_4"
                    android:paddingBottom="@dimen/vs_1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/ts_9"
                    android:visibility="gone"
                    tools:text="1920 x 1080" />
            </LinearLayout>
        </LinearLayout>

        <!-- 控制按钮行：紧贴信息条下方，8 个等宽按钮 -->
        <LinearLayout
            android:id="@+id/llControlRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_control_bottom"
            android:orientation="horizontal"
            android:padding="@dimen/vs_3">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLineSelectChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_24"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="线路选择"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_9" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvScaleChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_24"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="画面比例"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_9" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDecoderChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_24"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="播放解码"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_9" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTimeoutChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_24"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="超时换源"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_9" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMultiSourceChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_24"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="多源切换"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_9" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvConfigChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_24"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="配置切换"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_9" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFullscreenChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_24"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="点击全屏"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_9" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBackChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_24"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="点击返回"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_9" />
        </LinearLayout>

        <!-- 频道选择：左侧分组、右侧频道，均可上下滑动 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_0"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="@dimen/vs_4">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGroupListView"
                android:layout_width="@dimen/vs_110"
                android:layout_height="match_parent"
                android:divider="@null"
                android:fadeScrollbars="false"
                android:listSelector="@drawable/item_bg_selector_left"
                android:padding="@dimen/vs_4"
                android:scrollbars="none" />

            <View
                android:id="@+id/vChannelDivider"
                android:layout_width="@dimen/vs_1"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/vs_2"
                android:background="#FF333333" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mChannelListView"
                android:layout_width="@dimen/vs_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:divider="@null"
                android:fadeScrollbars="false"
                android:listSelector="@drawable/item_bg_selector_right"
                android:padding="@dimen/vs_4"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
