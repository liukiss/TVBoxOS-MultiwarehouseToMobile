<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_12"
    android:paddingTop="@dimen/vs_8"
    android:paddingRight="@dimen/vs_12">

    <!-- 顶部搜索栏：输入框 + 清空 + 搜索（手机紧凑单行） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_40"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="@dimen/vs_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/input_search"
            android:hint="请输入要搜索的内容"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:textColor="@android:color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="@dimen/vs_50"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_6"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="清空"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_18" />

        <TextView
            android:id="@+id/tvSearch"
            android:layout_width="@dimen/vs_60"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_6"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="搜索"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>

    <!-- 热词 + 历史：竖向滚动，标签自动换行，符合手机浏览习惯 -->
    <ScrollView
        android:id="@+id/llWordsScroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_0"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vs_20">

            <!-- 热门标题行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_36"
                android:layout_marginTop="@dimen/vs_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wordSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_user_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingLeft="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_10"
                    android:singleLine="true"
                    android:text="热  门"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_22"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_1"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSearchCheckboxBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/vs_30"
                    android:background="@drawable/shape_user_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_10"
                    android:singleLine="true"
                    android:text="指定搜索源"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>

            <!-- 热词流式标签 -->
            <GridLayout
                android:id="@+id/hotWordGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="1" />

            <!-- 历史区（聚合搜索模式下显示） -->
            <LinearLayout
                android:id="@+id/llHistoryWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_30"
                    android:layout_marginTop="@dimen/vs_14"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHistoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:letterSpacing="0.08"
                        android:singleLine="true"
                        android:text="历  史"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_22"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="@dimen/vs_0"
                        android:layout_height="@dimen/vs_1"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/tvHistoryClear"
                        android:layout_width="@dimen/vs_30"
                        android:layout_height="@dimen/vs_30"
                        android:background="@drawable/shape_user_focus"
                        android:focusable="true"
                        android:padding="@dimen/vs_6"
                        android:src="@drawable/icon_delete" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/historyWordGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_4"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:columnCount="1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 搜索结果区 -->
    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_0"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/vs_6"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="invisible"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="false"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>

    <!-- TV 屏幕键盘：手机版隐藏保留 -->
    <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
        android:id="@+id/keyBoardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
