<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_gravity="center"
        android:paddingTop="@dimen/vs_1"
        android:paddingBottom="@dimen/vs_1"
        android:paddingLeft="@dimen/vs_5"
        android:paddingRight="@dimen/vs_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!-- 手机版：去掉系统自带大号复选框，改由 CheckboxSearchAdapter 设置与文字等高的图标 -->
        <CheckBox
            android:id="@+id/oneSearchSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/vs_25"
            android:button="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_14"
            android:text="1111"/>
    </LinearLayout>
</FrameLayout>
