<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/vs_12"
        android:layout_marginTop="@dimen/vs_12"
        android:layout_marginRight="@dimen/vs_12"
        android:layout_marginBottom="@dimen/vs_12"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_14">

        <!-- 字幕来源：内置 / 本地 / 在线，三项横排 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_30"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/selectInternal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="选择内置字幕"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/selectLocal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/vs_6"
                android:layout_marginLeft="@dimen/vs_6"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="选择本地字幕"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/selectRemote"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/vs_6"
                android:layout_marginLeft="@dimen/vs_6"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="在线搜索字幕"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <!-- 字号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_30"
            android:layout_marginTop="@dimen/vs_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/subtitleSizeMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="字号减小"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/subtitleSizeText"
                android:layout_width="@dimen/vs_70"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_6"
                android:layout_marginRight="@dimen/vs_6"
                android:gravity="center"
                android:text="16"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/subtitleSizePlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="字号增大"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <!-- 样式与位置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_30"
            android:layout_marginTop="@dimen/vs_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/subtitleStyleOne"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:shadowColor="@color/color_CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="字幕样式一"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/subtitlePositionText"
                android:layout_width="@dimen/vs_70"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_6"
                android:layout_marginRight="@dimen/vs_6"
                android:gravity="center"
                android:text="0%"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/subtitleStyleTwo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:shadowColor="@color/dialog_text_primary"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="字幕样式二"
                android:textColor="@color/color_FFB6C1"
                android:textSize="@dimen/ts_14"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 提示 -->
        <TextView
            android:id="@+id/subtitleTimeHint"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_22"
            android:layout_marginTop="@dimen/vs_6"
            android:gravity="center"
            android:text="字幕延时仅对外挂字幕有效"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_10" />

        <!-- 延时 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_30"
            android:layout_marginTop="@dimen/vs_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/subtitleTimeMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="字幕提前"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/subtitleTimeText"
                android:layout_width="@dimen/vs_70"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_6"
                android:layout_marginRight="@dimen/vs_6"
                android:gravity="center"
                android:text="0"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/subtitleTimePlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="字幕推迟"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
