<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/vs_12"
    android:layout_marginRight="@dimen/vs_12"
    android:background="@drawable/shape_danmu_setting_bg"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_14"
    android:paddingTop="@dimen/vs_12"
    android:paddingRight="@dimen/vs_14"
    android:paddingBottom="@dimen/vs_12">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:shadowColor="@color/color_000000_60"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        android:text="投屏到设备"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_16"
        android:textStyle="bold" />

     <TextView
        android:id="@+id/tvCastTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/vs_2"
        android:text="确认电视/盒子已安装TVBox或已打开DLNA投屏\n电视/盒子与手机连接在同一Wi-Fi下"
        android:textColor="@color/dialog_text_hint"
        android:textSize="@dimen/ts_10" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_110"
        android:layout_marginTop="@dimen/vs_10">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:scrollbars="vertical"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_6" />

        <com.github.tvbox.osc.ui.tv.widget.LoadingRingView
            android:id="@+id/progressBar"
            android:layout_width="@dimen/vs_32"
            android:layout_height="@dimen/vs_32"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvScanning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_36"
            android:text="正在搜索设备..."
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_10" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="未找到可用设备"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_10"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_32"
            android:layout_marginRight="@dimen/vs_6"
            android:layout_weight="1"
            android:background="@drawable/button_dialog_main"
            android:focusable="true"
            android:gravity="center"
            android:text="刷新"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_32"
            android:layout_marginLeft="@dimen/vs_6"
            android:layout_weight="1"
            android:background="@drawable/button_dialog_main"
            android:focusable="true"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_16"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
