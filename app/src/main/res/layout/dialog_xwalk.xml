<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/vs_16"
        android:layout_marginRight="@dimen/vs_16"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_16">

        <TextView
            android:id="@+id/downXWalkArch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:focusable="false"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/vs_6"
            android:lineSpacingMultiplier="0"
            android:text="下载XWalkView运行组件"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_14" />

        <TextView
            android:id="@+id/downXWalk"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_36"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_14"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:text="下载"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_16" />

    </LinearLayout>
</FrameLayout>
