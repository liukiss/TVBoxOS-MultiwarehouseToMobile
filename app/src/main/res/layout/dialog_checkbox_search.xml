<?xml version="1.0" encoding="utf-8"?>
<!-- 手机版：指定搜索源面板，与换源面板共用底部弹出效果与尺寸（由代码统一设置窗口大小） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_bottom_sheet_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_10">

        <!-- 标题行：手指按住可向下拖动关闭面板 -->
        <LinearLayout
            android:id="@+id/sheetTitleBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_36"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_6"
            android:paddingRight="@dimen/vs_6">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="指定搜索源"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_16"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/checkAll"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_30"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14"
                android:text="全选" />

            <TextView
                android:id="@+id/clearAll"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_30"
                android:layout_marginLeft="@dimen/vs_8"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="全不选"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_6"
            android:layout_weight="1"
            android:orientation="vertical" />

    </LinearLayout>

</FrameLayout>
