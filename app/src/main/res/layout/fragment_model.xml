<?xml version="1.0" encoding="utf-8"?>
<!-- 手机版设置页：单列分组列表，所有 id 与原 TV 版一一对应，仅重构排版与尺寸 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/vs_12"
    android:paddingRight="@dimen/vs_12">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/vs_10"
            android:paddingBottom="@dimen/vs_20">

            <!-- ===== 数据源 ===== -->
            <TextView
                style="@style/setting_section_title"
                android:text="数据源" />

            <LinearLayout
                android:id="@+id/llDebug"
                style="@style/setting_row"
                android:visibility="gone">

                <TextView
                    style="@style/setting_row_label"
                    android:text="调试模式" />

                <TextView
                    android:id="@+id/tvDebugOpen"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llApi"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="配置地址" />

                <TextView
                    android:id="@+id/tvApi"
                    style="@style/setting_row_value"
                    android:ellipsize="middle" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llApiHistory"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="配置历史" />

                <TextView
                    android:id="@+id/tvMediaCodec1"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llLiveSource"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="直播地址" />

                <TextView
                    android:id="@+id/tvLiveApi"
                    style="@style/setting_row_value"
                    android:ellipsize="middle" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llApiLine"
                style="@style/setting_row"
                android:visibility="gone">

                <TextView
                    style="@style/setting_row_label"
                    android:text="线路选择" />

                <TextView
                    android:id="@+id/tvApiLine"
                    style="@style/setting_row_value"
                    android:ellipsize="middle" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHomeApi"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="首页站源" />

                <TextView
                    android:id="@+id/tvHomeApi"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <!-- ===== 首页 ===== -->
            <TextView
                style="@style/setting_section_title"
                android:text="首页" />

            <LinearLayout
                android:id="@+id/llHomeRec"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="首页推荐" />

                <TextView
                    android:id="@+id/tvHomeRec"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHomeRecStyle"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="首页多行" />

                <TextView
                    android:id="@+id/showRecStyleText"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvHomeLive"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="下次进入" />

                <TextView
                    android:id="@+id/tvHomeText"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <!-- ===== 搜索 ===== -->
            <TextView
                style="@style/setting_section_title"
                android:text="搜索" />

            <LinearLayout
                android:id="@+id/llSearchView"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="搜索展示" />

                <TextView
                    android:id="@+id/tvSearchView"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/showFastSearch"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="聚合搜索" />

                <TextView
                    android:id="@+id/showFastSearchText"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <!-- ===== 播放 ===== -->
            <TextView
                style="@style/setting_section_title"
                android:text="播放" />

            <LinearLayout
                android:id="@+id/llPlay"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="播放器" />

                <TextView
                    android:id="@+id/tvPlay"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llMediaCodec"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="IJK解码方式" />

                <TextView
                    android:id="@+id/tvMediaCodec"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llRender"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="渲染方式" />

                <TextView
                    android:id="@+id/tvRenderType"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llScale"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="画面缩放" />

                <TextView
                    android:id="@+id/tvScaleType"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/autoSwitchLine"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="自动换线" />

                <TextView
                    android:id="@+id/autoSwitchLineText"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/showPreview"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="窗口预览" />

                <TextView
                    android:id="@+id/showPreviewText"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llIjkCachePlay"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="IJK缓存" />

                <TextView
                    android:id="@+id/tvIjkCachePlay"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llKeepScreenOn"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="播放时保持亮屏" />

                <TextView
                    android:id="@+id/tvKeepScreenOn"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/m3u8Ad"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="去广告" />

                <TextView
                    android:id="@+id/m3u8AdText"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <!-- ===== 弹幕 ===== -->
            <TextView
                style="@style/setting_section_title"
                android:text="弹幕" />

            <LinearLayout
                android:id="@+id/danmuOpen"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="弹幕" />

                <TextView
                    android:id="@+id/danmuOpenText"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/danmuApi"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="弹幕地址" />

                <TextView
                    android:id="@+id/danmuApiText"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <!-- ===== 其他 ===== -->
            <TextView
                style="@style/setting_section_title"
                android:text="其他" />

            <LinearLayout
                android:id="@+id/llDns"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="安全DNS" />

                <TextView
                    android:id="@+id/tvDns"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llParseWebVew"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="嗅探Webview" />

                <TextView
                    android:id="@+id/tvParseWebView"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHistoryMerge"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="历史合并" />

                <TextView
                    android:id="@+id/tvHistoryMerge"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHistoryNum"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="历史记录" />

                <TextView
                    android:id="@+id/tvHistoryNum"
                    style="@style/setting_row_value" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llWp"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="换张壁纸" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llWpRecovery"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="重置壁纸" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llClearCache"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="清空缓存" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llBackup"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="数据备份" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAbout"
                style="@style/setting_row">

                <TextView
                    style="@style/setting_row_label"
                    android:text="关于" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/setting_row_arrow"
                    android:text=">" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
