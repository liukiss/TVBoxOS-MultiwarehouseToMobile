<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_12">

    <!-- 标题行：拖动条可向下拖动关闭 -->
    <LinearLayout
        android:id="@+id/sheetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_2"
        android:paddingBottom="@dimen/vs_2">

        <View
            android:id="@+id/dragHandle"
            android:layout_width="@dimen/vs_36"
            android:layout_height="@dimen/vs_4"
            android:layout_gravity="center_horizontal"
            android:background="@color/dialog_text_hint" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:gravity="center"
            android:text="线路切换"
            android:textColor="@color/dialog_text_primary"
            android:textStyle="bold"
            android:textSize="@dimen/ts_28" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_2"
            android:gravity="center"
            android:text="当前使用接口数据"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_4"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <com.github.tvbox.osc.ui.tv.widget.LoadingRingView
            android:id="@+id/loading"
            android:layout_width="@dimen/vs_50"
            android:layout_height="@dimen/vs_50"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_6"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingTop="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_6"
            android:text="关闭"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>
</LinearLayout>
