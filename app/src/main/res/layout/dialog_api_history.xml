<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_14">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/vs_36"
        android:layout_height="@dimen/vs_4"
        android:layout_gravity="center_horizontal"
        android:background="@color/dialog_text_hint" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/vs_4"
        android:text="选择线路\n当前使用接口数据"
        android:textColor="@color/dialog_text_primary"
        android:textStyle="bold"
        android:textSize="@dimen/ts_30" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:gravity="right">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_danmu_setting"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_10"
            android:text="关闭"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</LinearLayout>
