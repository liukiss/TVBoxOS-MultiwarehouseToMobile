<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_340"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/vs_14">

        <EditText
            android:id="@+id/input"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_30"
            android:layout_weight="1"
            android:background="@drawable/input_dialog_api_input"
            android:hint="请输入密码"
            android:inputType="textPassword"
            android:maxLines="1"
            android:minHeight="@dimen/vs_30"
            android:paddingLeft="@dimen/vs_6"
            android:paddingRight="@dimen/vs_6"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/dialog_text_hint"
            android:textSize="@dimen/ts_14" />

        <TextView
            android:id="@+id/inputSubmit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_30"
            android:layout_marginLeft="@dimen/vs_8"
            android:layout_marginStart="@dimen/vs_8"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:text="确定"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_14" />

    </LinearLayout>
</FrameLayout>
