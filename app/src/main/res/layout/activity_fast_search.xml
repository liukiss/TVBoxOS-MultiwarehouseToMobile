<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- 左侧列：搜索对象（关键词）在上，站点列表在下 -->
        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="@dimen/vs_90"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_4"
            android:paddingTop="@dimen/vs_6"
            android:paddingRight="@dimen/vs_4"
            android:paddingBottom="@dimen/vs_4">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewWordFenci"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_2"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_2" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewWord"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_0"
                android:layout_marginTop="@dimen/vs_4"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_2"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_2" />
        </LinearLayout>

        <!-- 右侧列：搜索完成状态条 + 结果网格，左右边界即结果图片边界 -->
        <LinearLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_8"
            android:paddingRight="@dimen/vs_8"
            android:paddingBottom="@dimen/vs_10"
            tools:ignore="InOrMmUsage">

            <TextView
                android:id="@+id/mSearchTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_30"
                android:layout_marginTop="@dimen/vs_6"
                android:layout_marginBottom="@dimen/vs_4"
                android:background="@drawable/bg_fast_site_word_all"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_6"
                android:paddingRight="@dimen/vs_6"
                android:singleLine="true"
                android:text="&#x51C6;&#x5907;&#x641C;&#x7D22;"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_18" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_0"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="@dimen/vs_4"
                android:paddingBottom="@dimen/vs_6"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_4"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_6" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewFilter"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_0"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="@dimen/vs_4"
                android:paddingBottom="@dimen/vs_6"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_4"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_4" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
