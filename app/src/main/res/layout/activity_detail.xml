<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部播放/封面区：16:9 观感 -->
        <FrameLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_200">

            <FrameLayout
                android:id="@+id/thumbContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_detail_thumb_bg">

                <ImageView
                    android:id="@+id/ivThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <View
                android:id="@+id/previewPlayerPlace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 播放区之下全部内容：全屏播放时整体隐藏 -->
        <LinearLayout
            android:id="@+id/llDetailContent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_0"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:paddingTop="@dimen/vs_10">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_4"
                android:focusable="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_26" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_4"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:focusable="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:focusable="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:focusable="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:focusable="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:focusable="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_4"
                android:focusable="false"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/tvDirector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_4"
                android:focusable="false"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/tvPlayUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_4"
                android:ellipsize="end"
                android:singleLine="true"
                android:focusable="false"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_20" />

            <!-- 简介：固定高度 + 内部滑动，避免长简介挤压下方剧集区 -->
            <ScrollView
                android:id="@+id/scDesc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_40"
                android:focusable="false"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tvDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_20" />
            </ScrollView>

            <!-- 功能按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlay"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/vs_4"
                    android:layout_marginRight="@dimen/vs_4"
                    android:background="@drawable/button_detail_play"
                    android:focusable="true"
                    android:nextFocusUp="@id/previewPlayerBlock"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="立即播放"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvQuickSearch"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/vs_4"
                    android:layout_marginRight="@dimen/vs_4"
                    android:background="@drawable/button_detail_quick_search"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="快速搜索"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/vs_4"
                    android:layout_marginRight="@dimen/vs_4"
                    android:background="@drawable/button_detail_sort"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="简介"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvCollect"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/vs_4"
                    android:layout_marginRight="@dimen/vs_4"
                    android:background="@drawable/button_detail_collect"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="加入收藏"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvChangeSource"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:background="@drawable/button_detail_change_source"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="切源"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mEmptyPlaylist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/vs_128"
                    android:layout_height="@dimen/vs_128"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_empty" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/vs_10"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:gravity="center"
                    android:text="暂无播放数据"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_24" />
            </LinearLayout>

            <!-- mGridViewFlag 区域 -->
            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewFlag"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_36"
                android:layout_marginTop="@dimen/vs_4"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:nextFocusUp="@id/previewPlayerPlace"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_selectedItemIsCentered="false" />

            <LinearLayout
                android:id="@+id/mSeriesGroupTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/vs_6"
                android:gravity="center_vertical"
                android:focusable="false"
                android:visibility="gone">

                <!-- 排序功能按钮 -->
                <TextView
                    android:id="@+id/mSeriesSortTv"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/vs_36"
                    android:background="@drawable/shape_source_series_focus"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_8"
                    android:text="正序"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:focusable="true"
                    android:nextFocusUp="@id/mGridViewFlag"
                    android:nextFocusDown="@id/mGridView"
                    android:nextFocusRight="@id/mSeriesGroupView"/>

                <!-- 原来的 mSeriesGroupView -->
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/mSeriesGroupView"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_selectedItemIsCentered="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/mGridViewFlag"
                    android:nextFocusDown="@id/mGridView"
                    android:nextFocusLeft="@id/mSeriesSortTv"/>
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewQuality"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_36"
                android:layout_marginTop="@dimen/vs_6"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:visibility="gone"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_selectedItemIsCentered="false" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_0"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/vs_6"
                android:layout_marginBottom="@dimen/vs_6"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_6" />
        </LinearLayout>
    </LinearLayout>

    <!-- 内嵌预览播放器：与顶部播放区同位；全屏时 MATCH_PARENT 撑满根布局 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_200"
        android:layout_gravity="top"
        android:background="@drawable/preview_player_round"
        android:visibility="gone" />

    <View
        android:id="@+id/previewPlayerBlock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_200"
        android:layout_gravity="top"
        android:focusable="true"
        android:nextFocusDown="@id/mGridViewFlag"
        android:background="@drawable/preview_player_block"
        android:visibility="gone" />
</FrameLayout>
