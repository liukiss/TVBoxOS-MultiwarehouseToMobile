<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="#331890FF" />
            <stroke android:width="1mm" android:color="@color/color_1890FF" />
            <corners android:radius="0mm" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/color_6C3D3D3D" />
            <stroke android:width="1mm" android:color="@android:color/white" />
            <corners android:radius="0mm" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/color_6C3D3D3D" />
            <corners android:radius="0mm" />
        </shape>
    </item>
</selector>
